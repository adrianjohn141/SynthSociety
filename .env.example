# Live minds (Azure OpenAI). Copy to .env.local, fill in, restart `npm run dev`. Never commit .env.local.
# Endpoint of your Azure OpenAI / Foundry resource, e.g. https://my-resource.openai.azure.com
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
# The deployment name you gave the model in Foundry (for example a gpt-4.1-mini or gpt-5-mini deployment)
AZURE_OPENAI_DEPLOYMENT=
# Optional: leave empty to use the v1 API; set (e.g. 2025-04-01-preview) to use the per-deployment URL instead
AZURE_OPENAI_API_VERSION=
# Optional, reasoning models only (gpt-5, o-series): minimal | low | medium
AZURE_OPENAI_REASONING_EFFORT=
